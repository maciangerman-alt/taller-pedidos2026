rules_version = '2';

// =====================================================================
//  REGLAS DE FIRESTORE PROPUESTAS — taller-artesanal-902ac
//  Archivo de PROPUESTA (21/11/2026). NO está enganchado al deploy:
//  firebase.json no lo usa a propósito. Se copian a mano en la consola
//  (Firestore → Reglas) DESPUÉS de probarlas en el simulador.
// =====================================================================
//
//  ANTES DE PUBLICAR (no saltear: un error acá deja sin panel o sin ventas)
//  ---------------------------------------------------------------------
//  1. Copiá y guardá las reglas que hay HOY en la consola (para volver
//     atrás en 1 minuto si algo falla).
//  2. Reemplazá UID_GERMAN y UID_NORA (abajo, en staff()) por los UID
//     reales: consola → Authentication → Users → columna "User UID".
//     Si Pablo u otra persona usa el panel, agregá su UID también.
//     Si usan costos/ con cuentas de empleados, cargá sus UID en personal().
//  3. Pegá estas reglas en Firestore → Reglas, SIN publicar, y abrí el
//     "Simulador de reglas" (Rules Playground). Probá cada caso:
//
//     | Operación | Ruta                              | Autenticado      | Esperado |
//     |-----------|-----------------------------------|------------------|----------|
//     | create    | pedidos/AbCdEfGhIjKlMnOpQrSt      | no (catálogo)    | PERMITIR con el JSON de ejemplo de abajo |
//     | create    | pedidos/AbCdEfGhIjKlMnOpQrSt      | no               | DENEGAR si agregás "cae":"1" o "factura":true |
//     | create    | pedidos/_config_facturacion       | no               | DENEGAR |
//     | get       | pedidos/cualquiera                | no               | DENEGAR |
//     | get       | pedidos/cualquiera                | sí, UID_GERMAN   | PERMITIR |
//     | get       | pedidos/cualquiera                | sí, otro UID     | DENEGAR |
//     | update    | pedidos/<uno real con CAE de producción> cambiando "cae" | UID_GERMAN | DENEGAR |
//     | update    | pedidos/<uno real> cambiando "estado"                    | UID_GERMAN | PERMITIR |
//     | update    | pedidos/_config_facturacion       | UID_GERMAN       | DENEGAR |
//     | get       | _arca_tickets/produccion          | UID_GERMAN       | DENEGAR |
//     | get       | maestros/clientes                 | cualquier login  | PERMITIR |
//     | get/set   | carritos/3815555555               | no               | PERMITIR (set con {carrito:{}, updatedAt:"..."}) |
//     | set       | fidelidad/3815555555              | no               | PERMITIR con {compras:1, ultimaCompra:"...", tel:"3815555555"} |
//
//     JSON de ejemplo de un pedido del catálogo (create anónimo):
//     {"nombre":"Seño Caro","escuela":"Jardín 45","tel":"3815555555",
//      "productos":"2 Rompecabezas","total":12000,"obs":"","provincia":"",
//      "ciudad":"","estado":"confirmado","fechaPedido":"2026-11-21",
//      "fechaEntrega":"","pago":"Al recibir","metodoPago":"recibir",
//      "senia":0,"logistica":"","turno":"","cuit":"","razon":"",
//      "factura":false,"facturaEmitida":false,
//      "createdAt":"2026-11-21T12:00:00.000Z","updatedAt":"2026-11-21T12:00:00.000Z",
//      "origen":"catalogo-web"}
//
//  4. Publicá y, en los 5 minutos siguientes, probá en serio:
//     - hacer un pedido de prueba en el catálogo (tallerartesanal.com.ar),
//     - abrir el panel logueado (lista de pedidos, editar uno, metas),
//     - Datos, Facturas, Inicio y costos/ logueado,
//     - "Borrar factura de PRUEBA" en un pedido de homologación.
//     Si algo falla: volver a pegar las reglas viejas del paso 1.
//
//  Ojo: analisis-clientas-taller.html hoy lee "pedidos" SIN login. Con
//  estas reglas deja de andar hasta que tenga login (lo agrega el cambio
//  del front-end) y el usuario esté en staff().
//
//  Ojo 2: el worker de Mercado Pago (taller-pagos) no está en este repo.
//  Si escribe en Firestore con una cuenta de servicio, estas reglas no le
//  afectan. Si escribe por REST SIN credenciales, hay que agregarle una
//  regla; revisarlo antes de publicar.
//
//  Recordatorio: en Firestore las reglas se suman con OR. Un "deny"
//  específico NO le gana a un "allow" más amplio, por eso acá no hay
//  ningún comodín /{document=**}: lo que no está listado, queda cerrado.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------- quién es quién
    function logueado() { return request.auth != null; }

    // Personas que usan el panel de pedidos y facturas (ver paso 2).
    function staff() {
      return logueado() && request.auth.uid in ['UID_GERMAN', 'UID_NORA'];
    }

    // Empleados que usan costos/ (pestaña Corte). Vacío = nadie extra.
    function personal() {
      return logueado() && request.auth.uid in [];
    }

    // Campos que SOLO escribe la Cloud Function facturarPedido (Admin SDK,
    // que ignora estas reglas). Desde el navegador no se pueden cambiar en
    // una factura de producción (SEC-7): ni el CAE, ni el número, ni el
    // link del PDF, ni los candados contra la doble emisión.
    function camposFactura() {
      return ['cae', 'caeVencimiento', 'nroComprobante', 'puntoVenta',
              'tipoComprobanteLetra', 'tipoComprobanteCodigo', 'facturaFecha',
              'facturaImporte', 'facturaImpNeto', 'facturaImpIVA',
              'facturaDocTipo', 'facturaDocNro', 'facturaCondicionIVAReceptor',
              'facturaAmbiente', 'facturaObservaciones', 'facturaEmitidaAt',
              'facturaEmitidaPor', 'facturaPdfUrl', 'facturaIntento',
              'facturaEnProceso', 'facturaEnProcesoDesde'];
    }

    function txt(v, max) { return v is string && v.size() <= max; }

    // ------------------------------------------- pedido del catálogo público
    // index.html crea el pedido SIN login (addDoc). Se acepta solo con la
    // forma exacta que arma el catálogo y SIN ningún dato fiscal: así nadie
    // puede meter por la API un pedido "listo para facturar" a un CUIT y
    // monto arbitrarios (SEC-3), ni un ID con comillas para XSS (SEC-2).
    function pedidoCatalogoValido(d) {
      return d.keys().hasOnly(['nombre', 'escuela', 'tel', 'productos', 'total', 'obs',
                               'provincia', 'ciudad', 'estado', 'fechaPedido',
                               'fechaEntrega', 'pago', 'metodoPago', 'senia',
                               'logistica', 'turno', 'cuit', 'razon', 'factura',
                               'facturaEmitida', 'createdAt', 'updatedAt', 'origen'])
        && d.keys().hasAll(['nombre', 'escuela', 'productos', 'total', 'estado', 'origen'])
        && d.origen == 'catalogo-web'
        && d.estado == 'confirmado'
        && d.get('factura', false) == false
        && d.get('facturaEmitida', false) == false
        && d.get('cuit', '') == ''
        && d.get('razon', '') == ''
        && d.get('senia', 0) == 0
        && txt(d.nombre, 120) && txt(d.escuela, 200) && txt(d.get('tel', ''), 40)
        && txt(d.productos, 8000) && txt(d.get('obs', ''), 2000)
        && txt(d.get('pago', ''), 120) && txt(d.get('metodoPago', ''), 20)
        && txt(d.get('provincia', ''), 80) && txt(d.get('ciudad', ''), 120)
        && d.total is number && d.total >= 0 && d.total < 100000000;
    }

    // ------------------------------------------------------------- pedidos
    match /pedidos/{id} {
      // Leer: solo el staff. Incluye _config_facturacion y _config_metas,
      // porque el panel escucha la colección entera (onSnapshot) y las
      // reglas NO son filtros: si un doc de la colección no se puede leer,
      // la consulta completa falla. _config_facturacion no tiene secretos
      // (CUIT, mails/UIDs autorizados); los certificados están en Secret
      // Manager.
      allow read: if staff();

      // Crear: el catálogo (anónimo, ID automático de 20 caracteres y forma
      // validada) o el staff (sin campos fiscales ni docs de config, salvo
      // _config_metas que el panel crea con set+merge).
      allow create: if (id.matches('^[A-Za-z0-9]{20}$') && pedidoCatalogoValido(request.resource.data))
                    || (staff() && id != '_config_facturacion'
                        && !request.resource.data.keys().hasAny(camposFactura()));

      // Modificar: solo el staff, nunca la config fiscal, y sin tocar los
      // campos fiscales. Excepción: facturas de HOMOLOGACIÓN (pruebas), para
      // que "Borrar factura de PRUEBA" siga funcionando; aun así no se puede
      // convertir una prueba en "producción".
      // Además, un pedido con CAE de producción no se puede desmarcar como
      // "Requiere factura" / "factura emitida" (ARCA-14).
      allow update: if staff() && id != '_config_facturacion' && (
                       (
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposFactura())
                         && (
                           !('cae' in resource.data)
                           || resource.data.get('facturaAmbiente', '') == 'homologacion'
                           || (request.resource.data.get('factura', true) == true
                               && request.resource.data.get('facturaEmitida', true) == true)
                         )
                       )
                       || (resource.data.get('facturaAmbiente', '') == 'homologacion'
                           && request.resource.data.get('facturaAmbiente', 'homologacion') == 'homologacion')
                     );

      // Borrar: solo el staff, nunca la config, y nunca un pedido con
      // factura de producción (se anula con nota de crédito, no borrando).
      allow delete: if staff() && id != '_config_facturacion' && !id.matches('^_config.*')
                    && (!('cae' in resource.data)
                        || resource.data.get('facturaAmbiente', '') == 'homologacion');
    }

    // ------------------------------------------- solo la Cloud Function
    // Ticket de acceso a ARCA (token+sign): con él se puede facturar en
    // nombre del CUIT durante 12 h. Y el registro de numeración que evita
    // la doble emisión. El navegador no los lee ni los escribe: la
    // Function usa el Admin SDK, que no pasa por estas reglas.
    match /_arca_tickets/{id}    { allow read, write: if false; }
    match /_arca_numeracion/{id} { allow read, write: if false; }

    // --------------------------------------- base de clientes y productos
    // -------------------------------------------------- PDFs de facturas
    // Sin plan Blaze los PDF se guardan acá (los escribe solo el servidor del
    // facturador). Cada id es aleatorio de 32 caracteres: quien tiene el link
    // (la seño por WhatsApp) puede abrir ESA factura con factura.html, pero
    // nadie puede listar la colección ni modificarla desde el navegador.
    match /facturas_pdf/{id} {
      allow get: if id.matches('^[a-f0-9]{32}$');
      allow list, write: if false;
    }

    // Página Datos (maestros.js), panel e Inicio: docs clientes / productos
    // (meta), clientes_0..N (bloques) y clientes_respaldo (copia automática
    // antes de "Reemplazar todo"). Cualquier usuario
    // logueado. Si el alta de usuarios no está desactivada en
    // Authentication, conviene cambiar logueado() por staff().
    match /maestros/{id} {
      allow read: if logueado();
      allow write: if logueado() && id.matches('^(clientes|productos)(_[0-9]{1,3}|_respaldo)?$');
    }

    // ------------------------------------------------------------ costos/
    // costos/index.html: los admins ven todo; el "personal" ve solo Corte.
    // Cualquier usuario logueado, como hoy; ajustar por rol si hace falta.
    match /costos_corte/{id}      { allow read, write: if logueado(); }
    match /costos_config/{id}     { allow read, write: if logueado(); }
    match /costos_modelo/{id}     { allow read, write: if logueado(); }
    match /costos_importados/{id} { allow read, write: if logueado(); }
    match /costos_consultas/{id}  { allow read, write: if logueado(); }
    match /costos_memoria/{id}    { allow read, write: if logueado(); }

    // ------------------------------------- catálogo público: carrito
    // index.html guarda/lee/borra el carrito por teléfono (últimos 10
    // dígitos) SIN login. Se permite solo get (no list: nadie puede bajar
    // todos los carritos) y una forma fija. Riesgo conocido (PRIV-2): quien
    // sepa un teléfono puede ver o pisar ese carrito.
    match /carritos/{tel} {
      allow get, delete: if tel.matches('^[0-9]{8,10}$');
      allow create, update: if tel.matches('^[0-9]{8,10}$')
                            && request.resource.data.keys().hasOnly(['carrito', 'updatedAt'])
                            && txt(request.resource.data.get('updatedAt', ''), 40);
    }

    // ------------------------------------- catálogo público: fidelidad
    // index.html incrementa el contador desde el navegador, SIN login. Para
    // no romperlo se permite, pero acotado: forma fija, el tel del doc
    // tiene que coincidir con el ID, y cada escritura sube de a 1 (o vuelve
    // a 0 al llegar a 10 / pasado un año). Riesgo conocido (PRIV-2):
    // alguien puede sumar compras de a una. Lo correcto es mover el
    // incremento al worker de Mercado Pago o al panel y dejar acá solo get.
    match /fidelidad/{tel} {
      allow get: if tel.matches('^[0-9]{6,15}$');
      allow create: if tel.matches('^[0-9]{6,15}$')
                    && request.resource.data.keys().hasOnly(['compras', 'ultimaCompra', 'tel'])
                    && request.resource.data.tel == tel
                    && request.resource.data.compras is int
                    && request.resource.data.compras >= 0 && request.resource.data.compras <= 1
                    && txt(request.resource.data.ultimaCompra, 40);
      allow update: if tel.matches('^[0-9]{6,15}$')
                    && request.resource.data.keys().hasOnly(['compras', 'ultimaCompra', 'tel'])
                    && request.resource.data.tel == tel
                    && request.resource.data.compras is int
                    && (request.resource.data.compras == 0
                        || request.resource.data.compras == 1
                        || request.resource.data.compras == resource.data.get('compras', 0) + 1)
                    && request.resource.data.compras <= 10
                    && txt(request.resource.data.ultimaCompra, 40);
      allow delete: if staff();
    }
  }
}
